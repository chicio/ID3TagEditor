          "text": "Class that “makes your life easier” when it comes to read data from the ID3 tag.",
          "type": "text"
        },
        {
          "text": " ",
          "type": "text"
        },
        {
          "text": "Create an instance of this class by passing to it a ",
          "type": "text"
        },
        {
          "code": "ID3Tag",
          "type": "codeVoice"
        },
        {
          "text": " instance",
          "type": "text"
        },
        {
          "text": " ",
          "type": "text"
        },
        {
          "text": "(obtained from the read methods of ",
          "type": "text"
        },
        {
          "code": "ID3TagEditor",
          "type": "codeVoice"
        },
        {
          "text": ").",
          "type": "text"
        },
        {
          "text": " ",
          "type": "text"
        },
        {
          "text": "In this way you will now have access to all the data contained in the ID3 tag by using the methods of this class.",
          "type": "text"
        }
      ],
      "fragments": [
        {
          "kind": "keyword",
